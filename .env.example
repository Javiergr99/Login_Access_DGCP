# Login Access - plantilla de variables
#
# Reglas:
# - No subir archivos .env reales al repositorio.
# - Las variables VITE_* son visibles en el navegador: nunca guardar secretos.
# - Las URLs no deben terminar con slash (/).
# - localhost/127.0.0.1 se permiten únicamente en desarrollo.
# - Para el servidor 10.2.5.68 usar URLs alcanzables desde el navegador.

# auth_service
VITE_API_URL=

# Debe ser false en cualquier build de servidor/producción.
VITE_ENABLE_MOCKS=

# Destino activo en la fase actual.
VITE_MESA_AYUDA_URL=

# Destinos de módulos que se habilitarán conforme sean desplegados.
VITE_FORMATO_NNA_URL=
VITE_DIRECTORIO_PROCURADORES_URL=
VITE_CONTROL_AGENDA_URL=
VITE_ADMIN_URL=

# Sitios públicos / navegación institucional.
VITE_POR_TUS_DERECHOS_URL=
VITE_GOBMX_SEARCH_URL=
VITE_FORMATO_NNA_PUBLIC_URL=
